---
import { Image } from "astro:assets";
import poster from "../../assets/hero.svg";
import { SITE } from "../../site";

interface Props {
    /** Optional looping video (< 2 MB). The poster stays as the LCP image and the reduced-motion fallback. */
    video?: string;
}
const { video } = Astro.props;
---

<section class="hero" data-hero aria-labelledby="hero-title">
    <div class="hero-visual" data-hero-visual aria-hidden="true">
        <Image src={poster} alt="" loading="eager" fetchpriority="high" class="hero-media" />
        {video && <video class="hero-media hero-video" src={video} autoplay muted loop playsinline preload="none" />}
    </div>
    <div class="wrap hero-copy" data-hero-copy>
        <p class="eyebrow">
            {SITE.role} · {SITE.location}
        </p>
        <h1 id="hero-title" class="hero-title" data-hero-title>
            {SITE.brand}
        </h1>
        <p class="hero-typing" aria-hidden="true">
            <span class="text-accent">$</span> <span data-typing>fv init</span><span class="hero-caret"></span>
        </p>
        <p class="hero-tagline">{SITE.tagline}</p>
        <p class="mt-3 text-ink-soft">The personal hub of {SITE.name}.</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#work" class="btn btn-accent">
                Explore projects <span aria-hidden="true">↓</span>
            </a>
            <a href="/about/" class="btn font-mono">
                fv whoami
            </a>
            <button type="button" class="cmd ml-2 cursor-pointer hover:text-ink" data-boot-replay>
                fv init --replay
            </button>
        </div>
    </div>
</section>

<script>
    // Cycles through the hub's `fv <cmd>` voice. Decorative only: reduced motion keeps the static `fv init`.
    const el = document.querySelector<HTMLElement>("[data-typing]");
    if (el && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const cmds = ["init", "projects", "lab", "stack", "journal", "whoami", "connect"].map((c) => `fv ${c}`);
        const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
        (async () => {
            for (let i = 0; ; i = (i + 1) % cmds.length) {
                const cmd = cmds[i];
                for (let n = 3; n <= cmd.length; n++) {
                    el.textContent = cmd.slice(0, n);
                    await wait(70 + Math.random() * 60);
                }
                await wait(1600);
                for (let n = cmd.length; n >= 3; n--) {
                    el.textContent = cmd.slice(0, n);
                    await wait(35);
                }
            }
        })();
    }
</script>

<style>
    .hero {
        position: relative;
        display: grid;
        align-items: end;
        min-height: 100svh;
        overflow: hidden;
        padding-bottom: clamp(3rem, 8vh, 6rem);
    }
    .hero-visual {
        position: absolute;
        inset: 0;
        will-change: transform;
    }
    .hero-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--color-canvas) 5%, transparent 55%);
    }
    .hero-media {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .hero-copy {
        position: relative;
        display: flex;
        flex-direction: column;
    }
    .hero-title {
        margin-top: 0.75rem;
        font-size: var(--text-4xl);
    }
    .hero-typing {
        margin-top: 1rem;
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        white-space: pre;
    }
    .hero-caret {
        display: inline-block;
        width: 0.6em;
        height: 1.1em;
        margin-left: 0.15em;
        vertical-align: text-bottom;
        background: var(--color-accent);
        animation: hero-blink 1s steps(1) infinite;
    }
    @keyframes hero-blink {
        50% {
            opacity: 0;
        }
    }
    .hero-tagline {
        margin-top: 1.25rem;
        max-width: 32ch;
        font-size: var(--text-lg);
        color: var(--color-ink-soft);
    }
    @media (prefers-reduced-motion: reduce) {
        .hero-video {
            display: none;
        }
        .hero-caret {
            animation: none;
        }
    }
</style>
