---
import { Image } from 'astro:assets';
import poster from '../../assets/hero.svg';
import { SITE } from '../../site';

interface Props {
  /** Optional looping video (< 2 MB). The poster stays as the LCP image and the reduced-motion fallback. */
  video?: string;
}
const { video } = Astro.props;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-visual" data-hero-visual aria-hidden="true">
    <Image src={poster} alt="" loading="eager" fetchpriority="high" class="hero-media" />
    {video && <video class="hero-media hero-video" src={video} autoplay muted loop playsinline preload="none" />}
  </div>
  <div class="wrap hero-copy" data-hero-copy>
    <p class="eyebrow">Fullstack &amp; AI engineering</p>
    <h1 id="hero-title" class="hero-title" data-hero-title>{SITE.name}</h1>
    <p class="hero-tagline">{SITE.tagline}</p>
    <a href="#work" class="btn mt-8 w-fit">See the work <span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }
  .hero-visual {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-canvas) 5%, transparent 55%);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .hero-title {
    margin-top: 0.75rem;
    font-size: var(--text-4xl);
  }
  .hero-tagline {
    margin-top: 1.25rem;
    max-width: 32ch;
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
</style>
