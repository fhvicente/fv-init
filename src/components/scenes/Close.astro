---
import { SITE } from "../../site";

interface Props {
    /** h1 on /contact, h2 when it closes the home page */
    heading?: "h1" | "h2";
}
const { heading: Heading = "h2" } = Astro.props;
---

<section id="contact" class="section" aria-labelledby="contact-title">
    <div class="wrap">
        <p class="cmd" data-reveal>
            fv connect
        </p>
        <Heading id="contact-title" class="mt-4 max-w-[14ch] text-4xl" data-reveal>
            Let's build the next one<span class="text-accent">.</span>
        </Heading>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal>
            <a href={`mailto:${SITE.email}`} class="btn btn-accent">
                {SITE.email}
            </a>
            <a href={SITE.links.linkedin} class="btn">
                LinkedIn
            </a>
            <a href={SITE.links.github} class="btn">
                GitHub
            </a>
            <a href={SITE.cv} class="btn" download>
                Download CV (PDF)
            </a>
        </div>
    </div>
</section>
