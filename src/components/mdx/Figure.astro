---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="my-10">
  {
    typeof src === 'string' ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 760px) 65ch, 100vw" />
    )
  }
  {caption && <figcaption class="mt-3 text-sm text-ink-soft">{caption}</figcaption>}
</figure>
