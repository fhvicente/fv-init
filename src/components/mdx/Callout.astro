---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="callout">
  {title && <p class="font-display font-semibold text-ink">{title}</p>}
  <slot />
</aside>

<style>
  .callout {
    padding: 1.1em 1.3em;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
  }
  .callout > :global(* + *) {
    margin-top: 0.5em;
  }
</style>
