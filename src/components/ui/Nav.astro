---
import { getPosts } from "../../lib/content";

const hasPosts = (await getPosts()).length > 0;
const items = [
    { label: "Work", href: "/projects/" },
    { label: "Lab", href: "/lab/" },
    { label: "Stack", href: "/stack/" },
    ...(hasPosts ? [{ label: "Journal", href: "/journal/" }] : []),
    { label: "About", href: "/about/" },
    { label: "Contact", href: "/contact/" },
];
const path = Astro.url.pathname;
---

<header class="nav">
    <nav class="wrap flex items-center justify-between gap-4" aria-label="Main">
        <a href="/" class="font-display text-lg font-semibold tracking-tight" aria-label="FV, home">
            FV<span class="text-accent">.</span>
        </a>
        <ul class="flex text-sm sm:gap-2">
            {items.map((i) => (
                <li>
                    <a href={i.href} data-nav aria-current={path.startsWith(i.href) ? "page" : undefined}>
                        {i.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<style>
    .nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        padding-block: 1rem;
        background: linear-gradient(to bottom, var(--color-canvas) 30%, transparent);
    }
    a[data-nav] {
        position: relative;
        display: inline-block;
        padding: 0.4em 0.45em;
        border-radius: 999px;
        color: var(--color-ink-soft);
        text-decoration: none;
        transition: color var(--d-base) var(--ease-out);
    }
    @media (min-width: 640px) {
        a[data-nav] {
            padding-inline: 0.75em;
        }
    }
    a[data-nav]:hover,
    a[data-nav][aria-current] {
        color: var(--color-ink);
    }
    a[data-nav]::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 0.1em;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--color-accent);
        transform: translateX(-50%) scale(0);
        transition: transform var(--d-base) var(--ease-out);
    }
    a[data-nav][aria-current]::after {
        transform: translateX(-50%) scale(1);
    }
</style>
