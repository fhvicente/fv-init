---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page doesn't exist.">
    <section class="wrap grid min-h-[80svh] content-center">
        <p class="cmd">fv: page not found (404)</p>
        <h1 class="mt-4 max-w-[12ch] text-4xl">
            Off the map<span class="text-accent">.</span>
        </h1>
        <p class="mt-6 max-w-[40ch] text-lg text-ink-soft">This page doesn't exist, or it moved somewhere else.</p>
        <a href="/" class="btn btn-accent mt-10 w-fit">
            Back home
        </a>
    </section>
</Base>
