---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";
---

<Base title="Stack" description="Technologies and areas Flávio Vicente works with.">
    <section class="wrap pt-36 pb-[var(--section)]">
        <p class="cmd">fv stack</p>
        <h1 class="mt-4 text-4xl">Stack</h1>
        <p class="mt-6 max-w-[48ch] text-lg text-ink-soft">The tools I reach for, and have shipped real work with.</p>
        <dl class="mt-16 border-t border-hairline">
            {Object.entries(SITE.stack).map(([group, items]) => (
                <div class="grid gap-3 border-b border-hairline py-6 md:grid-cols-[14rem_1fr]">
                    <dt class="font-mono text-sm text-ink-soft">{group.toLowerCase()}</dt>
                    <dd>
                        <ul class="flex flex-wrap gap-2">
                            {items.map((s) => (
                                <li class="chip">{s}</li>
                            ))}
                        </ul>
                    </dd>
                </div>
            ))}
        </dl>
    </section>
</Base>
