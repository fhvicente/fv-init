---
import Base from "../layouts/Base.astro";
import Hero from "../components/scenes/Hero.astro";
import Threshold from "../components/scenes/Threshold.astro";
import Scene from "../components/scenes/Scene.astro";
import Close from "../components/scenes/Close.astro";
import BootSequence from "../components/BootSequence.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPosts, getProjects, formatDate } from "../lib/content";
import { SITE } from "../site";

const featured = (await getProjects("product")).filter((p) => p.data.featured);
const experiments = (await getProjects("experiment")).slice(0, 2);
const posts = (await getPosts()).slice(0, 3);
---

<Base>
    <BootSequence />
    <Hero />
    <Threshold projects={featured} />
    {featured.map((project, index) => (
        <Scene project={project} index={index} />
    ))}

    {experiments.length > 0 && (
        <section id="lab" class="section" aria-labelledby="lab-title">
            <div class="wrap">
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <p class="cmd" data-reveal>
                            fv lab
                        </p>
                        <h2 id="lab-title" class="mt-4 text-3xl" data-reveal>
                            Experiments &amp; prototypes
                        </h2>
                    </div>
                    <a href="/lab/" class="link" data-reveal>
                        Open the lab
                    </a>
                </div>
                <ul class="mt-12 grid gap-4 md:grid-cols-2">
                    {experiments.map((project) => (
                        <li data-reveal>
                            <ProjectCard project={project} />
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    )}

    <section id="stack" class="section" aria-labelledby="stack-title">
        <div class="wrap grid gap-10 md:grid-cols-[5fr_7fr]">
            <div>
                <p class="cmd" data-reveal>
                    fv stack
                </p>
                <h2 id="stack-title" class="mt-4 text-3xl" data-reveal>
                    What I build with
                </h2>
            </div>
            <div data-reveal>
                <dl class="grid gap-6 sm:grid-cols-2">
                    {Object.entries(SITE.stack).map(([group, items]) => (
                        <div>
                            <dt class="font-mono text-xs text-ink-soft">{group.toLowerCase()}</dt>
                            <dd class="mt-2">{items.join(" · ")}</dd>
                        </div>
                    ))}
                </dl>
                <a href="/stack/" class="link mt-8 inline-block">
                    Full stack
                </a>
            </div>
        </div>
    </section>

    {posts.length > 0 && (
        <section id="journal" class="section" aria-labelledby="journal-title">
            <div class="wrap">
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <p class="cmd" data-reveal>
                            fv journal
                        </p>
                        <h2 id="journal-title" class="mt-4 text-3xl" data-reveal>
                            Notes from the work
                        </h2>
                    </div>
                    <a href="/journal/" class="link" data-reveal>
                        All posts
                    </a>
                </div>
                <ul class="mt-12 grid gap-4 md:grid-cols-3">
                    {posts.map((post) => (
                        <li data-reveal>
                            <a href={`/journal/${post.id}/`} class="card">
                                <time class="text-xs text-ink-soft" datetime={post.data.date.toISOString()}>
                                    {formatDate(post.data.date)}
                                </time>
                                <h3 class="mt-3 text-xl">{post.data.title}</h3>
                                <p class="mt-3 text-sm text-ink-soft">{post.data.summary}</p>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    )}

    <section id="about" class="section" aria-labelledby="about-title">
        <div class="wrap grid gap-10 md:grid-cols-[5fr_7fr]">
            <div>
                <p class="cmd" data-reveal>
                    fv whoami
                </p>
                <h2 id="about-title" class="mt-4 text-3xl" data-reveal>
                    Hi, I'm Flávio.
                </h2>
            </div>
            <div data-reveal>
                <p class="text-lg text-ink-soft">
                    I'm a fullstack engineer who moved deep into AI engineering. I design and ship products end to end:
                    data models, APIs, interfaces and the LLM pieces that make them useful, with evals so they stay that
                    way.
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="/about/" class="btn">
                        More about me
                    </a>
                    <a href={SITE.cv} class="btn" download>
                        Download CV (PDF)
                    </a>
                </div>
            </div>
        </div>
    </section>

    <Close />
</Base>

<script>
    import { initMotion } from "../lib/motion";
    import { runBoot, replayBoot } from "../lib/boot";

    document.querySelector("[data-boot-replay]")?.addEventListener("click", replayBoot);
    runBoot().then(initMotion);
</script>
